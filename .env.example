DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

POSTGRES_DB=your_hosted_database_name
POSTGRES_USER=your_hosted_database_user
POSTGRES_PASSWORD=your_hosted_database_password
POSTGRES_HOST=your_hosted_database_host
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
