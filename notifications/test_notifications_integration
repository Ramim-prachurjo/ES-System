from django.test import TestCase
from django.urls import reverse

from accounts.models import CustomUser
from notifications.models import Notification


class NotificationIntegrationTests(TestCase):

    def setUp(self):
        self.player = CustomUser.objects.create_user(
            username="player",
            password="StrongPass123!",
            role="player",
        )

        self.other_player = CustomUser.objects.create_user(
            username="other",
            password="StrongPass123!",
            role="player",

        )

         # IT-NOT-01
    def test_notification_is_created_for_user(self):
        notification = Notification.objects.create(
            user=self.player,
            message="Test notification"
        )

        self.assertEqual(
            notification.user,
            self.player
        )

        self.assertFalse(
            notification.is_read
        )
  # IT-NOT-02
    def test_notification_list_shows_user_notifications(self):
        Notification.objects.create(
            user=self.player,
            message="Player notification"
        )

        Notification.objects.create(
            user=self.other_player,
            message="Other notification"
        )

        self.client.force_login(self.player)

        response = self.client.get(
            reverse("notification_list")
        )

        self.assertEqual(
            response.status_code,
            200
        )

        self.assertContains(
            response,
            "Player notification"
        )

        self.assertNotContains(
            response,
            "Other notification"
        )
